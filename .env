# MongoDB document/event datastore
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=nexus_itsm

# Keycloak (issuer must include /realms/<realm>)
KEYCLOAK_ISSUER=https://keycloak.accenture.example/realms/accenture
KEYCLOAK_CLIENT_ID=nexus-itsm
KEYCLOAK_AUDIENCE=nexus-itsm
ACCENTURE_EMAIL_DOMAIN=accenture.com

# KM uses a two-step IM -> short-token -> KM flow. Store all secrets in the
# deployment secret store and reference them by env:NAME in the admin UI/API.
KM_IM_CLIENT_ID=itsm-km-client
KM_IM_CLIENT_SECRET=replace-me
KM_API_TOKEN=replace-me

# Optional Consul KV resolver. References support consul:kv/path/to/secret
# and consul:kv/path/to/json#field. Do not commit a real ACL token.
CONSUL_HTTP_ADDR=https://consul.example:8501
CONSUL_HTTP_TOKEN=replace-me

# Use DEBUG only during a short diagnostic window; containers log to stdout.
LOG_LEVEL=INFO

# Local Development Persona & Mock Fixtures (true for local development; false in production)
SEED_DEMO_DATA=true
