        <mxCell id="auto_cicd" value="🚀 CI/CD Pipelines&#xa;(GitHub, GitLab, Jenkins)&#xa;Change Ticket API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontSize=10;fontStyle=1;fontColor=#065F46;" vertex="1" parent="col1_box">
          <mxGeometry x="15" y="310" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="auto_mon" value="📡 Monitoring / Observability&#xa;(Prometheus, Datadog, Dynatrace)&#xa;Auto Incident Creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontSize=10;fontStyle=1;fontColor=#065F46;" vertex="1" parent="col1_box">
          <mxGeometry x="15" y="380" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="auto_sec" value="🛡️ SIEM / SecOps&#xa;(Splunk, Sentinel, Wazuh)&#xa;Security Incident Intake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontSize=10;fontStyle=1;fontColor=#065F46;" vertex="1" parent="col1_box">
