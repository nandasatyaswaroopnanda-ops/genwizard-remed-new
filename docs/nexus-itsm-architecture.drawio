        <mxCell id="core_route" parent="col4_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#4ADE80;fontSize=9;align=left;spacingLeft=8;fontColor=#14532D;" value="🗺️ 6-Tier Waterfall Routing Engine&#xa;Automatic queue &amp; group assignment by:&#xa;Project → Application → Category → Priority&#xa;Auto On-Call Engineer Resolution" vertex="1">
          <mxGeometry height="60" width="290" x="10" y="155" as="geometry" />
