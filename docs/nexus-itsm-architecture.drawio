        <mxCell id="col1_box" value="CONSUMERS &amp; INTEGRATIONS" style="swimlane;startSize=28;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontStyle=1;fontSize=11;fontColor=#334155;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="660" as="geometry" />
        </mxCell>

        <mxCell id="act_enduser" value="🧑‍💼 End Users&#xa;(IM_SAML / ATR_SAML)&#xa;Portal: Create &amp; My Tickets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=10;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="col1_box">
          <mxGeometry x="15" y="45" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="act_support" value="🛠️ Support Engineers&#xa;L1 / L2 / L3 Groups&#xa;Queue &amp; Work Notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=10;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="col1_box">
          <mxGeometry x="15" y="115" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="act_admin" value="⚙️ IT Administrators&#xa;Global / Project Admin&#xa;SLAs, Routing, Projects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=10;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="col1_box">
          <mxGeometry x="15" y="185" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="div_auto" value="3rd-Party Direct Automations&#xa;(No MID Server Required!)" style="text;html=1;strokeColor=none;fillColor=#FEF3C7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=1;fontColor=#92400E;" vertex="1" parent="col1_box">
          <mxGeometry x="10" y="260" width="160" height="35" as="geometry" />
